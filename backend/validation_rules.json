{
  "rules": [
    {
      "name": "required_fields",
      "requiredFields": ["loan_id", "borrower_id", "origination_date", "original_principal"]
    },
    {
      "name": "valid_date_formats",
      "dateFields": ["origination_date", "maturity_date", "last_payment_date", "last_updated_at"]
    },
    {
      "name": "maturity_after_origination"
    },
    {
      "name": "no_negative_balance",
      "fields": ["original_principal", "current_balance"]
    },
    {
      "name": "balance_leq_principal"
    },
    {
      "name": "interest_rate_range",
      "min": 0,
      "max": 25
    },
    {
      "name": "valid_payment_status",
      "validValues": ["current", "delinquent", "default", "closed", "foreclosure"]
    },
    {
      "name": "payment_status_vs_dpd",
      "currentMaxDpd": 0
    },
    {
      "name": "document_status_check"
    },
    {
      "name": "duplicate_loan_id"
    },
    {
      "name": "duplicate_borrower_combo"
    },
    {
      "name": "valid_state_code",
      "validStates": ["AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY","DC"]
    },
    {
      "name": "stale_record",
      "maxAgeDays": 90
    },
    {
      "name": "servicer_conflict",
      "fieldsToCompare": ["current_balance", "payment_status", "days_past_due", "last_payment_date", "document_status"]
    },
    {
      "name": "closed_with_balance"
    },
    {
      "name": "repeated_borrower",
      "threshold": 3
    }
  ]
}
